# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Expense parsing
OPENAI_API_KEY=
OPENAI_EXPENSE_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# App URL used in provider callbacks and settlement links
APP_URL=https://your-vercel-domain.example
SETTLEMENT_WORKER_TOKEN=

# Prava: use matching sandbox or production key pairs
PRAVA_BACKEND_URL=https://sandbox.api.prava.space
PRAVA_SECRET_KEY=
NEXT_PUBLIC_PRAVA_PUBLISHABLE_KEY=
# Guide-compatible aliases also accepted by the application:
BACKEND_URL=https://sandbox.api.prava.space
MERCHANT_SECRET_KEY=
NEXT_PUBLIC_PUBLISHABLE_KEY=

# Cashfree Payments and Payouts
# Keep this in sandbox until both Cashfree products are enabled and verified.
CASHFREE_ENV=sandbox
CASHFREE_PG_CLIENT_ID=
CASHFREE_PG_CLIENT_SECRET=
CASHFREE_PG_API_VERSION=2026-01-01
# Optional: defaults to CASHFREE_PG_CLIENT_SECRET when blank.
CASHFREE_PG_WEBHOOK_SECRET=
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_API_VERSION=2024-01-01
# Optional on sandbox; for Vercel production, use this public-key signature unless Cashfree whitelists a stable IP.
CASHFREE_PAYOUT_PUBLIC_KEY=
# Optional: defaults to CASHFREE_PAYOUT_CLIENT_SECRET when blank.
CASHFREE_PAYOUT_WEBHOOK_SECRET=
# If Cashfree gives one shared pair for both products, the generic aliases are accepted.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Linq Partner API
LINQ_API_KEY=
LINQ_FROM_NUMBER=+10000000000
LINQ_WEBHOOK_SECRET=

# Email fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=
